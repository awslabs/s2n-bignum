# The ML-KEM API in AVX-512 assembly for x86-64 (see README.md), the build
# asm_avx512 of mlkem_native. This file is written by hand rather than
# generated by ../../../tools/native_proofs_mk.py: the proofs of this build
# are about the image of the functions linked by GNU ld
# (mlkem_native2_avx512_image.elf), and each of them proves the theorems of
# the functions that it calls again (it loads their proofs, those of the
# leaves in ../../proofs included) rather than assuming their contracts, so
# each target is closed by itself and the build has no link file. The
# targets are built by the rule of ../../Makefile for MLKEM_NATIVE_PROOFS,
# from the files in ../../proofs/mlkem_native/asm_avx512, with the
# dependencies below.

MLKEM_NATIVE_OBJ += \
  mlkem_native/asm_avx512/mlkem512_avx512.o \
  mlkem_native/asm_avx512/mlkem768_avx512.o \
  mlkem_native/asm_avx512/mlkem1024_avx512.o \
  mlkem_native/asm_avx512/mlkem_gen_matrix_avx512.o \
  mlkem_native/asm_avx512/mlkem_getnoise_avx512.o \
  mlkem_native/asm_avx512/mlkem_hash_g_avx512.o \
  mlkem_native/asm_avx512/mlkem_hash_h_avx512.o \
  mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.o \
  mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.o

MLKEM_NATIVE_PROOFS += \
  mlkem_native/asm_avx512/sha3_keccak_f1600_avx512 \
  mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512 \
  mlkem_native/asm_avx512/keccak_avx512_full \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k2_avx512 \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k3_avx512 \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k4_avx512 \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k2_safe_avx512 \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k3_safe_avx512 \
  mlkem_native/asm_avx512/mlkem_gen_matrix_k4_safe_avx512 \
  mlkem_native/asm_avx512/mlkem_getnoise_avx512 \
  mlkem_native/asm_avx512/mlkem_hash_g_avx512 \
  mlkem_native/asm_avx512/mlkem_hash_h_avx512 \
  mlkem_native/asm_avx512/mlkem512_avx512 \
  mlkem_native/asm_avx512/mlkem768_avx512 \
  mlkem_native/asm_avx512/mlkem1024_avx512

# The objects of the image of the functions, for their proofs, in the
# order of the image

MLKEM_ASM_AVX512_IMAGE_OBJ = \
        mlkem_native/asm_avx512/mlkem512_avx512.o \
        mlkem_native/asm_avx512/mlkem768_avx512.o \
        mlkem_native/asm_avx512/mlkem1024_avx512.o \
        mlkem_native/asm_avx512/mlkem_gen_matrix_avx512.o \
        mlkem_native/asm_avx512/mlkem_getnoise_avx512.o \
        mlkem_native/asm_avx512/mlkem_hash_g_avx512.o \
        mlkem_native/asm_avx512/mlkem_hash_h_avx512.o \
        mlkem/mlkem_add_reduce.o \
        mlkem/mlkem_basemul_k2.o \
        mlkem/mlkem_basemul_k3.o \
        mlkem/mlkem_basemul_k4.o \
        mlkem/mlkem_cbd2.o \
        mlkem/mlkem_cbd3.o \
        mlkem/mlkem_check_encoding.o \
        mlkem/mlkem_compress_d10_x86.o \
        mlkem/mlkem_compress_d11_x86.o \
        mlkem/mlkem_compress_d4_x86.o \
        mlkem/mlkem_compress_d5_x86.o \
        mlkem/mlkem_decompress_d10_x86.o \
        mlkem/mlkem_decompress_d11_x86.o \
        mlkem/mlkem_decompress_d4_x86.o \
        mlkem/mlkem_decompress_d5_x86.o \
        mlkem/mlkem_frombytes.o \
        mlkem/mlkem_frommsg.o \
        mlkem/mlkem_intt.o \
        mlkem/mlkem_mulcache_compute.o \
        mlkem/mlkem_ntt.o \
        mlkem/mlkem_reduce.o \
        mlkem/mlkem_rej_uniform_alt_VARIABLE_TIME.o \
        mlkem/mlkem_sub_reduce.o \
        mlkem/mlkem_tobytes.o \
        mlkem/mlkem_tomont.o \
        mlkem/mlkem_tomsg.o \
        mlkem/mlkem_unpack.o \
        mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.o \
        mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.o \
        mlkem_native/asm/mlkem_native2_constants.o

# The image, linked at 0 with GNU ld (the linker script is not for the
# Darwin linker)

mlkem_native/asm_avx512/mlkem_native2_avx512_image.elf: $(MLKEM_ASM_AVX512_IMAGE_OBJ) \
        mlkem_native/asm_avx512/mlkem_native2_avx512_image.ld
	$(LINK) --no-relax -e 0 -T mlkem_native/asm_avx512/mlkem_native2_avx512_image.ld \
	  -o $@ $(MLKEM_ASM_AVX512_IMAGE_OBJ)

# The AVX-512 version is assembled from the sources of ../asm, with the
# names of its mlkem_native2_names.h

MLKEM_ASM_AVX512_N2_DEPS = mlkem_native/asm/mlkem_native2_consts.h \
                           mlkem_native/asm/mlkem_native2_names.h
mlkem_native/asm_avx512/mlkem512_avx512.o mlkem_native/asm_avx512/mlkem768_avx512.o \
mlkem_native/asm_avx512/mlkem1024_avx512.o: mlkem_native/asm/mlkem_kem_template.S \
                                         $(MLKEM_ASM_AVX512_N2_DEPS)
mlkem_native/asm_avx512/mlkem_gen_matrix_avx512.o: \
        mlkem_native/asm/mlkem_gen_matrix.S $(MLKEM_ASM_AVX512_N2_DEPS)
mlkem_native/asm_avx512/mlkem_getnoise_avx512.o: \
        mlkem_native/asm/mlkem_getnoise.S $(MLKEM_ASM_AVX512_N2_DEPS)
mlkem_native/asm_avx512/mlkem_hash_g_avx512.o: \
        mlkem_native/asm/mlkem_hash_g.S $(MLKEM_ASM_AVX512_N2_DEPS)
mlkem_native/asm_avx512/mlkem_hash_h_avx512.o: \
        mlkem_native/asm/mlkem_hash_h.S $(MLKEM_ASM_AVX512_N2_DEPS)

# The kernels that depend on the parameter set, which only its proofs load
MLKEM_ASM_AVX512_CODECS_11_5 = \
  proofs/mlkem_compress_d5_x86.ml mlkem/mlkem_compress_d5_x86.o \
  proofs/mlkem_compress_d11_x86.ml mlkem/mlkem_compress_d11_x86.o \
  proofs/mlkem_decompress_d5_x86.ml mlkem/mlkem_decompress_d5_x86.o \
  proofs/mlkem_decompress_d11_x86.ml mlkem/mlkem_decompress_d11_x86.o
MLKEM_ASM_AVX512_CODECS_10_4 = \
  proofs/mlkem_compress_d4_x86.ml mlkem/mlkem_compress_d4_x86.o \
  proofs/mlkem_compress_d10_x86.ml mlkem/mlkem_compress_d10_x86.o \
  proofs/mlkem_decompress_d4_x86.ml mlkem/mlkem_decompress_d4_x86.o \
  proofs/mlkem_decompress_d10_x86.ml mlkem/mlkem_decompress_d10_x86.o
MLKEM512_ASM_AVX512_KERNELS = $(MLKEM_ASM_AVX512_CODECS_10_4) \
  proofs/mlkem_basemul_k2.ml mlkem/mlkem_basemul_k2.o mlkem/mlkem_basemul_k2.obj
MLKEM768_ASM_AVX512_KERNELS = $(MLKEM_ASM_AVX512_CODECS_10_4) \
  proofs/mlkem_basemul_k3.ml mlkem/mlkem_basemul_k3.o mlkem/mlkem_basemul_k3.obj
MLKEM1024_ASM_AVX512_KERNELS = $(MLKEM_ASM_AVX512_CODECS_11_5) \
  proofs/mlkem_basemul_k4.ml mlkem/mlkem_basemul_k4.o mlkem/mlkem_basemul_k4.obj

MLKEM_ASM_AVX512_KECCAK_PROOF = proofs/utils/keccak_spec.ml \
                                    proofs/utils/keccak_avx2.ml \
                                    proofs/utils/keccak_avx512.ml
mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.native: \
  $(MLKEM_ASM_AVX512_KECCAK_PROOF) \
  mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.o
mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.native: \
  $(MLKEM_ASM_AVX512_KECCAK_PROOF) \
  mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.o
mlkem_native/asm_avx512/keccak_avx512_full.native: \
  $(MLKEM_ASM_AVX512_KECCAK_PROOF) \
  proofs/mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.ml \
  proofs/mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.ml \
  mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.o \
  mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.o

MLKEM_ASM_AVX512_IMAGE_PROOF = \
  mlkem_native/asm_avx512/mlkem_native2_avx512_image.elf \
  proofs/mlkem_native/asm_avx512/mlkem_native2_avx512_image.ml \
  proofs/utils/mlkem_native2_tools.ml
MLKEM_ASM_AVX512_SPONGE_PROOF = $(MLKEM_ASM_AVX512_IMAGE_PROOF) \
  proofs/utils/mlkem_native2_avx512_sponge.ml \
  proofs/utils/keccak_fips202.ml \
  proofs/utils/mlkem_bytes.ml \
  $(MLKEM_ASM_AVX512_KECCAK_PROOF) \
  proofs/mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.ml \
  mlkem_native/asm_avx512/sha3_keccak_f1600_avx512.o
mlkem_native/asm_avx512/mlkem_hash_g_avx512.native: \
  $(MLKEM_ASM_AVX512_SPONGE_PROOF)
mlkem_native/asm_avx512/mlkem_hash_h_avx512.native: \
  $(MLKEM_ASM_AVX512_SPONGE_PROOF)
MLKEM_ASM_AVX512_NOISE_PROOF = $(MLKEM_ASM_AVX512_SPONGE_PROOF) \
  proofs/utils/mlkem_native2_avx512_noise.ml \
  proofs/mlkem_cbd2.ml mlkem/mlkem_cbd2.o \
  proofs/mlkem_cbd3.ml mlkem/mlkem_cbd3.o \
  proofs/mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.ml \
  mlkem_native/asm_avx512/sha3_keccak4_f1600_avx512.o
mlkem_native/asm_avx512/mlkem_getnoise_avx512.native: \
  $(MLKEM_ASM_AVX512_NOISE_PROOF)
MLKEM_ASM_AVX512_GM_PROOF = $(MLKEM_ASM_AVX512_NOISE_PROOF) \
  proofs/mlkem_native/asm_avx512/mlkem_getnoise_avx512.ml \
  proofs/utils/mlkem_native_fips203.ml \
  proofs/utils/mlkem_native2_avx512_matrix.ml \
  proofs/mlkem_rej_uniform_alt_VARIABLE_TIME.ml \
  mlkem/mlkem_rej_uniform_alt_VARIABLE_TIME.o \
  proofs/mlkem_unpack.ml mlkem/mlkem_unpack.o mlkem/mlkem_unpack.obj \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_avx512.ml
mlkem_native/asm_avx512/mlkem_gen_matrix_k2_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_PROOF)
mlkem_native/asm_avx512/mlkem_gen_matrix_k3_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_PROOF)
mlkem_native/asm_avx512/mlkem_gen_matrix_k4_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_PROOF)
MLKEM_ASM_AVX512_GM_SAFE_PROOF = $(MLKEM_ASM_AVX512_GM_PROOF) \
  proofs/utils/mlkem_native2_avx512_safety.ml \
  proofs/mlkem_native/asm_avx512/keccak_avx512_full.ml \
  proofs/utils/mlkem_native2_avx512_keccak_full.ml \
  proofs/utils/mlkem_native2_rej_full.ml \
  proofs/utils/mlkem_native2_avx512_gm_safe.ml
mlkem_native/asm_avx512/mlkem_gen_matrix_k2_safe_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_SAFE_PROOF)
mlkem_native/asm_avx512/mlkem_gen_matrix_k3_safe_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_SAFE_PROOF)
mlkem_native/asm_avx512/mlkem_gen_matrix_k4_safe_avx512.native: \
  $(MLKEM_ASM_AVX512_GM_SAFE_PROOF)
MLKEM_ASM_AVX512_API_PROOF = $(MLKEM_ASM_AVX512_NOISE_PROOF) \
  proofs/utils/mlkem_native2_avx512_safety.ml \
  proofs/utils/mlkem_compress_consts.ml \
  proofs/utils/mlkem_native2_avx512_api.ml \
  proofs/mlkem_ntt.ml mlkem/mlkem_ntt.o mlkem/mlkem_ntt.obj \
  proofs/mlkem_rej_uniform_alt_VARIABLE_TIME.ml \
  mlkem/mlkem_rej_uniform_alt_VARIABLE_TIME.o \
  proofs/mlkem_native/asm_avx512/mlkem_hash_h_avx512.ml \
  proofs/mlkem_check_encoding.ml mlkem/mlkem_check_encoding.o
MLKEM_ASM_AVX512_KEM_PROOF = $(MLKEM_ASM_AVX512_API_PROOF) \
  $(MLKEM_ASM_AVX512_GM_PROOF) \
  proofs/utils/mlkem_native2_kpke.ml \
  proofs/utils/mlkem_native2_avx512_kem.ml \
  proofs/mlkem_native/asm_avx512/mlkem_hash_g_avx512.ml \
  proofs/mlkem_intt.ml mlkem/mlkem_intt.o mlkem/mlkem_intt.obj \
  proofs/mlkem_mulcache_compute.ml \
  mlkem/mlkem_mulcache_compute.o mlkem/mlkem_mulcache_compute.obj \
  proofs/mlkem_tomont.ml mlkem/mlkem_tomont.o mlkem/mlkem_tomont.obj \
  proofs/mlkem_reduce.ml mlkem/mlkem_reduce.o mlkem/mlkem_reduce.obj \
  proofs/mlkem_add_reduce.ml mlkem/mlkem_add_reduce.o \
  proofs/mlkem_sub_reduce.ml mlkem/mlkem_sub_reduce.o \
  proofs/mlkem_tobytes.ml mlkem/mlkem_tobytes.o mlkem/mlkem_tobytes.obj \
  proofs/mlkem_frombytes.ml mlkem/mlkem_frombytes.o mlkem/mlkem_frombytes.obj \
  proofs/mlkem_frommsg.ml mlkem/mlkem_frommsg.o \
  proofs/mlkem_tomsg.ml mlkem/mlkem_tomsg.o
MLKEM_ASM_AVX512_KEM_SAFE_PROOF = $(MLKEM_ASM_AVX512_KEM_PROOF) \
  $(MLKEM_ASM_AVX512_GM_SAFE_PROOF) \
  proofs/utils/mlkem_native2_avx512_kem_safe.ml
mlkem_native/asm_avx512/mlkem512_avx512.native: \
  $(MLKEM_ASM_AVX512_KEM_SAFE_PROOF) \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k2_avx512.ml \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k2_safe_avx512.ml \
  $(MLKEM512_ASM_AVX512_KERNELS)
mlkem_native/asm_avx512/mlkem768_avx512.native: \
  $(MLKEM_ASM_AVX512_KEM_SAFE_PROOF) \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k3_avx512.ml \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k3_safe_avx512.ml \
  $(MLKEM768_ASM_AVX512_KERNELS)
mlkem_native/asm_avx512/mlkem1024_avx512.native: \
  $(MLKEM_ASM_AVX512_KEM_SAFE_PROOF) \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k4_avx512.ml \
  proofs/mlkem_native/asm_avx512/mlkem_gen_matrix_k4_safe_avx512.ml \
  $(MLKEM1024_ASM_AVX512_KERNELS)
