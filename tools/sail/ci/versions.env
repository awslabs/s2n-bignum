# The Sail proofs' HOL Light. The other CI jobs pin their own, with
# HOLLIGHT_COMMIT in .github/workflows/ci.yml; the two need not agree.
HOL_LIGHT_COMMIT=433477862bb90b328a593e012e09390e99b2439b

# Sail plugins must use the compiler and library built in the same switch.
SAIL_OCAML_VERSION=4.14.2
SAIL_OPAM_PACKAGES="ocamlfind.1.9.8 dune.3.24.2 dune-site.3.24.2 menhir.20250912 ott.0.34 lem.2026-05-01 linksem.0.8 pprint.20230830 yojson.3.0.0 conf-gmp.5"

# Match the native HOL Light build used for the checked-in conformance proofs.
HOL_OCAML_VERSION=4.14.0
HOL_OPAM_PACKAGES="ocamlfind.1.9.8 zarith.1.14 camlp5.8.03.06"
