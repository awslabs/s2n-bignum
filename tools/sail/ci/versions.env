# Source revisions used by the two independent Sail/HOL CI checks.
SAIL_COMMIT=3df54034910b31a1e00d948ee965b2e9603d68e0
SAIL_ARM_COMMIT=f5bf6c3a2b5df8c7f6f9d3572825ff074e0c6b7c
