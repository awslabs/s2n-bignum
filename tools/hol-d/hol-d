import argparse
import base64
import fcntl
import json
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import threading
import time

from daemon import start_server


HERE = Path(__file__).resolve().parent


def arguments():
    # Allow connection options on either side of the subcommand.
    common = argparse.ArgumentParser(add_help=False, argument_default=argparse.SUPPRESS)
    common.add_argument("--socket", type=Path, help="socket in a private directory you own")
    common.add_argument("--start-if-needed", action="store_true", help="start a missing daemon")
    parser = argparse.ArgumentParser(description=__doc__, parents=[common])
    commands = parser.add_subparsers(dest="cmd", required=True)
    def command(name, help):
        return commands.add_parser(name, help=help, parents=[common])
    command("start", "wait for a ready HOL root")
    command("stop", "stop all sessions")
    command("tree", "list session paths, PIDs and states")
    fork = command("fork", "branch from a session")
    fork.add_argument("path")
    fork.add_argument("name")
    load = command("load", "initialize a native plugin in a leaf")
    mode = load.add_mutually_exclusive_group(required=True)
    mode.add_argument("--public", dest="public", action="store_true")
    mode.add_argument("--private", dest="public", action="store_false")
    load.add_argument("path")
    load.add_argument("plugin", type=lambda value: str(Path(value).resolve()))
    run = command("run", "fork a child, run a private plugin and wait for its exit")
    run.add_argument("path", help="session to fork")
    run.add_argument("plugin", type=lambda value: str(Path(value).resolve()))
    command("repl", "attach to a leaf's HOL prompt").add_argument("path")
    kill = command("kill", "terminate a session")
    kill.add_argument("--tree", action="store_true", help="also terminate all descendants")
    kill.add_argument("path")
    return vars(parser.parse_args())


def private_directory(path, create):
    if create:
        path.mkdir(mode=0o700, exist_ok=True)
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise ValueError(f"expected an owned 0700 directory: {path}")


def socket_path(custom, create):
    if custom:
        path = custom.absolute()
    else:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        if runtime:
            private_directory(Path(runtime), False)
            directory = Path(runtime) / "hol-d"
        else:
            directory = Path("/tmp") / f"hol-d-{os.getuid()}"
        path = directory / "socket"
    try:
        private_directory(path.parent, create)
    except FileNotFoundError:
        if create:
            raise
        raise ValueError(f"no daemon at {path}; run hol-d start") from None
    # The daemon also listens on PATH.session/nodes. Unix socket paths are
    # limited to 107 bytes.
    if len(os.fsencode(path)) + len(".session/nodes") > 107:
        raise ValueError(f"socket path too long (at most 93 bytes): {path}")
    return path


def connect(path):
    client = socket.socket(socket.AF_UNIX)
    try:
        client.connect(str(path))
        return client
    except BaseException:
        client.close()
        raise


def launch(path, lock):
    if path.is_symlink() or (path.exists() and not path.is_socket()):
        raise ValueError(f"expected a Unix socket: {path}")
    path.unlink(missing_ok=True)
    log = path.with_name(path.name + ".log")
    with log.open("wb") as out:
        # The daemon retains the lock through socket removal at shutdown.
        start_server(path, Path.cwd(), HERE / "build", out, (lock.fileno(),))


def connection(path, start, announce=False):
    waiting = False
    while True:
        try:
            client = connect(path)
            if announce and not waiting:
                print("Server already running ...", end=" ", file=sys.stderr, flush=True)
            return client
        except (FileNotFoundError, ConnectionRefusedError):
            if not start:
                raise ValueError(f"no daemon at {path}; run hol-d start")
        with path.with_name(path.name + ".lock").open("ab") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                if announce and not waiting:
                    print("Waiting for server ...", end=" ", file=sys.stderr, flush=True)
                    waiting = True
                time.sleep(0.1)
                continue
            if announce and not waiting:
                print("Starting server ...", end=" ", file=sys.stderr, flush=True)
                waiting = True
            launch(path, lock)


def send_input(client):
    # A terminal reader may still be blocked when another CLI freezes this
    # session. Avoid holding Python's buffered stdin lock during shutdown.
    pending = b""
    try:
        while True:
            chunk = os.read(sys.stdin.fileno(), 8192)
            lines = (pending + chunk).split(b"\n")
            pending = lines.pop()
            for line in lines:
                client.sendall(json.dumps({"line": os.fsdecode(line) + "\n"}).encode() + b"\n")
            if not chunk:
                break
        if pending:
            client.sendall(json.dumps({"line": os.fsdecode(pending)}).encode() + b"\n")
        client.shutdown(socket.SHUT_WR)
    except OSError:
        pass  # The parent froze or the node exited while stdin was open.


def main():
    args = arguments()
    start = args.pop("start_if_needed", False) or args["cmd"] == "start"
    os.umask(0o077)
    path = socket_path(args.pop("socket", None), start)
    started = time.monotonic()
    announce = args["cmd"] == "start"
    with connection(path, start, announce) as client, client.makefile("rb") as responses:
        client.sendall(json.dumps(args).encode() + b"\n")
        attached = False
        failed = False
        for line in responses:
            reply = json.loads(line)
            if "output" in reply:
                sys.stdout.buffer.write(base64.b64decode(reply["output"]))
                sys.stdout.buffer.flush()
            elif "prompt" in reply:
                if sys.stdin.isatty():
                    print("# ", end="", flush=True)
                if not attached:
                    threading.Thread(target=send_input, args=(client,), daemon=True).start()
                    attached = True
            elif "diagnostic" in reply:
                failed = True
                print(reply["diagnostic"], file=sys.stderr)
            elif "error" in reply:
                raise ValueError(reply["error"])
            elif "done" in reply:
                if announce:
                    print(f"OK ({time.monotonic() - started:.1f} s)", file=sys.stderr)
                return int(failed)
        raise ValueError("daemon disconnected before replying")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
    except KeyboardInterrupt:
        sys.exit(130)
