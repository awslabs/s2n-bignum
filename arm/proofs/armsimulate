#!/usr/bin/env bash

# Compile and execute one AArch64 cosimulation case.
#
# Usage: armsimulate instruction-words [state-word ...]
#
# instruction-words is a comma-separated list accepted by the assembler's
# .inst directive, for example 0xd503201f for NOP. The following arguments
# initialize up to 128 unsigned 64-bit state words; omitted words are zero.
# The command prints all 128 resulting state words to standard output.

set -u

DIR="$(dirname -- "${BASH_SOURCE[0]}")"
DIR="$(realpath -- "$DIR")"
read -r -a CC_COMMAND <<< "${CC:-cc}"
read -r -a AS_COMMAND <<< "${AS:-as}"

RUN_STAGE=idle
RUN_STATUS=0
CURRENT_TEMP=""

cleanup_case() {
  if [[ -n "$CURRENT_TEMP" ]]; then
    rm -f -- "$CURRENT_TEMP" "${CURRENT_TEMP}.S" "${CURRENT_TEMP}.o"
    CURRENT_TEMP=""
  fi
}

trap cleanup_case EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

run_once() {
  local code=$1
  shift

  RUN_STAGE=tempfile
  CURRENT_TEMP="$(mktemp)" || return 1
  local temp_s="${CURRENT_TEMP}.S"
  local temp_o="${CURRENT_TEMP}.o"

  RUN_STAGE=preprocess
  if ! "${CC_COMMAND[@]}" "-DICODE=$code" -E -xassembler-with-cpp \
      "$DIR/template.S" -o "$temp_s"; then
    cleanup_case
    return 1
  fi

  RUN_STAGE=assemble
  if ! "${AS_COMMAND[@]}" "$temp_s" -o "$temp_o"; then
    cleanup_case
    return 1
  fi

  RUN_STAGE=link
  if ! "${CC_COMMAND[@]}" -o "$CURRENT_TEMP" "$DIR/simulator.c" "$temp_o"; then
    cleanup_case
    return 1
  fi

  RUN_STAGE=execute
  "$CURRENT_TEMP" "$@"
  RUN_STATUS=$?
  cleanup_case
  return "$RUN_STATUS"
}

cd "$DIR"

if (( $# == 0 )); then
  printf 'usage: %s instruction-words [state-word ...]\n' "$0" >&2
  exit 2
fi

code=$1
shift
run_once "$code" "$@"
run_status=$?
if [[ "$RUN_STAGE" != execute ]]; then
  exit 1
fi
exit "$run_status"
