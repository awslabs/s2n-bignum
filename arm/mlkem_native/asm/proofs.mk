# The ML-KEM API in assembly for AArch64 (see README.md), the build asm of
# mlkem_native. This file is written by hand rather than generated by
# ../../../tools/native_proofs_mk.py: the proofs of this build are about
# the image of the functions linked by GNU ld (mlkem_native2_image.elf),
# and each of them proves the theorems of the functions that it calls again
# (it loads their proofs, those of the leaves in ../../proofs included)
# rather than assuming their contracts, so each target is closed by itself
# and the build has no link file. The targets are built by the rule of
# ../../Makefile for MLKEM_NATIVE_PROOFS, from the files in
# ../../proofs/mlkem_native/asm, with the dependencies below.

MLKEM_NATIVE_OBJ += \
  mlkem_native/asm/mlkem512.o \
  mlkem_native/asm/mlkem768.o \
  mlkem_native/asm/mlkem1024.o \
  mlkem_native/asm/mlkem_gen_matrix.o \
  mlkem_native/asm/mlkem_getnoise.o \
  mlkem_native/asm/mlkem_hash_g.o \
  mlkem_native/asm/mlkem_hash_h.o \
  mlkem_native/asm/mlkem_native2_constants.o

MLKEM_NATIVE_PROOFS += \
  mlkem_native/asm/mlkem_gen_matrix_k2 \
  mlkem_native/asm/mlkem_gen_matrix_k3 \
  mlkem_native/asm/mlkem_gen_matrix_k4 \
  mlkem_native/asm/mlkem_gen_matrix_k2_safe \
  mlkem_native/asm/mlkem_gen_matrix_k3_safe \
  mlkem_native/asm/mlkem_gen_matrix_k4_safe \
  mlkem_native/asm/mlkem_getnoise \
  mlkem_native/asm/mlkem_hash_g \
  mlkem_native/asm/mlkem_hash_h \
  mlkem_native/asm/mlkem512 \
  mlkem_native/asm/mlkem768 \
  mlkem_native/asm/mlkem1024

# The objects of the image of the functions, for their proofs (see
# ../../proofs/mlkem_native/asm/mlkem_native2_image.ml), in the order of the
# image

MLKEM_ASM_IMAGE_OBJ = mlkem_native/asm/mlkem512.o \
                          mlkem_native/asm/mlkem768.o \
                          mlkem_native/asm/mlkem1024.o \
                          mlkem_native/asm/mlkem_gen_matrix.o \
                          mlkem_native/asm/mlkem_getnoise.o \
                          mlkem_native/asm/mlkem_hash_g.o \
                          mlkem_native/asm/mlkem_hash_h.o \
                          mlkem/mlkem_add_reduce.o \
                          mlkem/mlkem_basemul_k2_alt.o \
                          mlkem/mlkem_basemul_k3_alt.o \
                          mlkem/mlkem_basemul_k4_alt.o \
                          mlkem/mlkem_cbd2.o \
                          mlkem/mlkem_cbd3.o \
                          mlkem/mlkem_check_encoding.o \
                          mlkem/mlkem_compress_d10.o \
                          mlkem/mlkem_compress_d11.o \
                          mlkem/mlkem_compress_d4.o \
                          mlkem/mlkem_compress_d5.o \
                          mlkem/mlkem_decompress_d10.o \
                          mlkem/mlkem_decompress_d11.o \
                          mlkem/mlkem_decompress_d4.o \
                          mlkem/mlkem_decompress_d5.o \
                          mlkem/mlkem_frombytes.o \
                          mlkem/mlkem_frommsg.o \
                          mlkem/mlkem_intt_alt.o \
                          mlkem/mlkem_mulcache_compute.o \
                          mlkem/mlkem_ntt_alt.o \
                          mlkem/mlkem_reduce.o \
                          mlkem/mlkem_rej_uniform_alt_VARIABLE_TIME.o \
                          mlkem/mlkem_sub_reduce.o \
                          mlkem/mlkem_tobytes_alt.o \
                          mlkem/mlkem_tomont.o \
                          mlkem/mlkem_tomsg.o \
                          sha3/sha3_keccak_f1600.o \
                          sha3/sha3_keccak4_f1600_alt2.o \
                          mlkem_native/asm/mlkem_native2_constants.o

# The image, linked at 0 with GNU ld (the linker script is not for the
# Darwin linker)

mlkem_native/asm/mlkem_native2_image.elf: $(MLKEM_ASM_IMAGE_OBJ) \
                                          mlkem_native/asm/mlkem_native2_image.ld
	$(LINK) --no-relax -e 0 -T mlkem_native/asm/mlkem_native2_image.ld \
	  -o $@ $(MLKEM_ASM_IMAGE_OBJ)

# The code of the API is in the template that the files for the parameter
# sets include

mlkem_native/asm/mlkem512.o mlkem_native/asm/mlkem768.o \
mlkem_native/asm/mlkem1024.o: mlkem_native/asm/mlkem_kem_template.S

# The proofs of the mlkem_native2 functions are about the image of all the
# functions they call, and use the theorems for the code of those.
MLKEM_ASM_IMAGE_PROOF = mlkem_native/asm/mlkem_native2_image.elf \
                            proofs/mlkem_native/asm/mlkem_native2_image.ml \
                            proofs/utils/mlkem_native_image.ml
MLKEM_ASM_SPONGE_PROOF = proofs/utils/mlkem_native2_sponge.ml \
                             proofs/utils/keccak_fips202.ml \
                             sha3/sha3_keccak_f1600.o
mlkem_native/asm/mlkem_hash_g.native: $(MLKEM_ASM_IMAGE_PROOF) \
                                   $(MLKEM_ASM_SPONGE_PROOF)
mlkem_native/asm/mlkem_hash_h.native: $(MLKEM_ASM_IMAGE_PROOF) \
                                   $(MLKEM_ASM_SPONGE_PROOF)
MLKEM_ASM_API_PROOF = $(MLKEM_ASM_IMAGE_PROOF) \
                          $(MLKEM_ASM_SPONGE_PROOF) \
                          proofs/utils/mlkem_native2_api.ml \
                          proofs/mlkem_native/asm/mlkem_hash_h.ml \
                          proofs/mlkem_check_encoding.ml \
                          mlkem/mlkem_check_encoding.o
MLKEM_ASM_NOISE_PROOF = $(MLKEM_ASM_IMAGE_PROOF) \
                            $(MLKEM_ASM_SPONGE_PROOF) \
                            proofs/utils/mlkem_native2_noise.ml \
                            proofs/mlkem_cbd2.ml mlkem/mlkem_cbd2.o \
                            proofs/mlkem_cbd3.ml mlkem/mlkem_cbd3.o \
                            proofs/sha3_keccak4_f1600_alt2.ml \
                            sha3/sha3_keccak4_f1600_alt2.o
mlkem_native/asm/mlkem_getnoise.native: $(MLKEM_ASM_NOISE_PROOF)
MLKEM_ASM_MATRIX_PROOF = $(MLKEM_ASM_NOISE_PROOF) \
                             proofs/utils/mlkem_native_fips203.ml \
                             proofs/utils/mlkem_native2_matrix.ml \
                             proofs/mlkem_rej_uniform_alt_VARIABLE_TIME.ml \
                             mlkem/mlkem_rej_uniform_alt_VARIABLE_TIME.o \
                             proofs/mlkem_native/asm/mlkem_getnoise.ml \
                             mlkem_native/asm/mlkem_getnoise.o
# The proofs of mlkem_gen_matrix, for each k in their own files (each level
# of the API needs only those for its k)
MLKEM_ASM_GM_PROOF = $(MLKEM_ASM_MATRIX_PROOF) \
                         proofs/mlkem_native/asm/mlkem_gen_matrix.ml \
                         mlkem_native/asm/mlkem_gen_matrix.o
mlkem_native/asm/mlkem_gen_matrix_k2.native: $(MLKEM_ASM_GM_PROOF)
mlkem_native/asm/mlkem_gen_matrix_k3.native: $(MLKEM_ASM_GM_PROOF)
mlkem_native/asm/mlkem_gen_matrix_k4.native: $(MLKEM_ASM_GM_PROOF)
MLKEM_ASM_GM_SAFE_PROOF = $(MLKEM_ASM_GM_PROOF) \
                              proofs/utils/mlkem_native2_safety.ml \
                              proofs/utils/mlkem_native2_keccak_full.ml \
                              proofs/utils/mlkem_native2_rej_full.ml \
                              proofs/utils/mlkem_native2_gm_safe.ml
mlkem_native/asm/mlkem_gen_matrix_k2_safe.native: $(MLKEM_ASM_GM_SAFE_PROOF)
mlkem_native/asm/mlkem_gen_matrix_k3_safe.native: $(MLKEM_ASM_GM_SAFE_PROOF)
mlkem_native/asm/mlkem_gen_matrix_k4_safe.native: $(MLKEM_ASM_GM_SAFE_PROOF)
# The kernels that depend on the parameter set, which only its proofs load
MLKEM_ASM_CODECS_10_4 = \
  proofs/mlkem_compress_d4.ml mlkem/mlkem_compress_d4.o \
  proofs/mlkem_compress_d10.ml mlkem/mlkem_compress_d10.o \
  proofs/mlkem_decompress_d4.ml mlkem/mlkem_decompress_d4.o \
  proofs/mlkem_decompress_d10.ml mlkem/mlkem_decompress_d10.o
MLKEM_ASM_CODECS_11_5 = \
  proofs/mlkem_compress_d5.ml mlkem/mlkem_compress_d5.o \
  proofs/mlkem_compress_d11.ml mlkem/mlkem_compress_d11.o \
  proofs/mlkem_decompress_d5.ml mlkem/mlkem_decompress_d5.o \
  proofs/mlkem_decompress_d11.ml mlkem/mlkem_decompress_d11.o
MLKEM512_ASM_KERNELS = $(MLKEM_ASM_CODECS_10_4) \
  proofs/mlkem_basemul_k2_alt.ml mlkem/mlkem_basemul_k2_alt.o
MLKEM768_ASM_KERNELS = $(MLKEM_ASM_CODECS_10_4) \
  proofs/mlkem_basemul_k3_alt.ml mlkem/mlkem_basemul_k3_alt.o
MLKEM1024_ASM_KERNELS = $(MLKEM_ASM_CODECS_11_5) \
  proofs/mlkem_basemul_k4_alt.ml mlkem/mlkem_basemul_k4_alt.o
MLKEM_ASM_KEM_PROOF = $(MLKEM_ASM_API_PROOF) \
                          $(MLKEM_ASM_MATRIX_PROOF) \
                          proofs/utils/mlkem_native2_kpke.ml \
                          proofs/utils/mlkem_native2_kem.ml \
                          proofs/utils/mlkem_native2_safety.ml \
                          proofs/utils/mlkem_native2_keccak_full.ml \
                          proofs/utils/mlkem_native2_kem_safe.ml \
                          proofs/utils/mlkem_bytes.ml \
                          proofs/mlkem_native/asm/mlkem_hash_g.ml mlkem_native/asm/mlkem_hash_g.o \
                          proofs/mlkem_native/asm/mlkem_gen_matrix.ml \
                          mlkem_native/asm/mlkem_gen_matrix.o \
                          proofs/mlkem_ntt_alt.ml mlkem/mlkem_ntt_alt.o \
                          proofs/mlkem_intt_alt.ml mlkem/mlkem_intt_alt.o \
                          proofs/mlkem_mulcache_compute.ml \
                          mlkem/mlkem_mulcache_compute.o \
                          proofs/mlkem_tomont.ml mlkem/mlkem_tomont.o \
                          proofs/mlkem_reduce.ml mlkem/mlkem_reduce.o \
                          proofs/mlkem_add_reduce.ml mlkem/mlkem_add_reduce.o \
                          proofs/mlkem_sub_reduce.ml mlkem/mlkem_sub_reduce.o \
                          proofs/mlkem_tobytes_alt.ml \
                          mlkem/mlkem_tobytes_alt.o \
                          proofs/mlkem_frombytes.ml mlkem/mlkem_frombytes.o \
                          proofs/mlkem_frommsg.ml mlkem/mlkem_frommsg.o \
                          proofs/mlkem_tomsg.ml mlkem/mlkem_tomsg.o
mlkem_native/asm/mlkem512.native: $(MLKEM_ASM_KEM_PROOF) \
                                $(MLKEM_ASM_GM_SAFE_PROOF) \
                                proofs/mlkem_native/asm/mlkem_gen_matrix_k2.ml \
                                proofs/mlkem_native/asm/mlkem_gen_matrix_k2_safe.ml \
                                $(MLKEM512_ASM_KERNELS)
mlkem_native/asm/mlkem768.native: $(MLKEM_ASM_KEM_PROOF) \
                               $(MLKEM_ASM_GM_SAFE_PROOF) \
                               proofs/mlkem_native/asm/mlkem_gen_matrix_k3.ml \
                               proofs/mlkem_native/asm/mlkem_gen_matrix_k3_safe.ml \
                               $(MLKEM768_ASM_KERNELS)
mlkem_native/asm/mlkem1024.native: $(MLKEM_ASM_KEM_PROOF) \
                                $(MLKEM_ASM_GM_SAFE_PROOF) \
                                proofs/mlkem_native/asm/mlkem_gen_matrix_k4.ml \
                                proofs/mlkem_native/asm/mlkem_gen_matrix_k4_safe.ml \
                                $(MLKEM1024_ASM_KERNELS)
